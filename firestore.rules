rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /botes/{boteId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.code is string
                    && request.resource.data.initialCapacity is number
                    && request.resource.data.currentCandies is number
                    && request.resource.data.status in ['waiting', 'active', 'ended'];
      allow update: if request.resource.data.name is string
                    && request.resource.data.currentCandies is number
                    && request.resource.data.status in ['waiting', 'active', 'ended'];
      allow delete: if false;

      match /players/{playerId} {
        allow read: if true;
        allow create: if request.resource.data.name is string 
                      && request.resource.data.name.size() <= 80
                      && request.resource.data.ticketNumber is number;
        allow update: if request.resource.data.ticketNumber is number;
        allow delete: if false;
      }

      match /ledger/{entryId} {
        allow read: if true;
        allow create: if request.resource.data.ticketNumber is number
                      && request.resource.data.playerName is string;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
